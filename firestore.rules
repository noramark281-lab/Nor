rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-All Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile & Preferences
    match /users/{userId} {
      allow get, write: if isValidId(userId) && isOwner(userId);

      // User Bots Subcollection
      match /bots/{botId} {
        allow read, write: if isValidId(userId) && isValidId(botId) && isOwner(userId);
      }

      // User Positions Subcollection
      match /positions/{positionId} {
        allow read, write: if isValidId(userId) && isValidId(positionId) && isOwner(userId);
      }

      // User Bot Logs Subcollection
      match /logs/{logId} {
        allow read, write: if isValidId(userId) && isValidId(logId) && isOwner(userId);
      }
    }
  }
}
